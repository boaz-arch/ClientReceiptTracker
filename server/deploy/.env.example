# Copy to .env (never commit .env) and fill in.

# Public URL the phones use, without a trailing slash.
PUBLIC_BASE_URL=https://apps.example.com/supportvisit

# Random secret for file links, sign-in codes and sessions, at least 32 characters:
#   openssl rand -base64 48
# Changing it signs everyone out.
LINK_SECRET=

# Outgoing email: sign-in codes, invitations and visit reports all come from SMTP_FROM.
# Any SMTP provider works (Microsoft 365, Google Workspace, Brevo, Mailgun, Amazon SES...).
# Microsoft 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587, the mailbox must allow "Authenticated SMTP".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=reports@example.com
# starttls (port 587, default) or ssl (port 465)
SMTP_TLS=starttls

# Product name shown in emails.
APP_NAME=Support Visit

# Report emails per day: per company, per company in its first 7 days (unless it has Pro),
# and for the whole server. They protect your sending address from abuse.
MAIL_DAILY_LIMIT=200
MAIL_NEW_COMPANY_DAILY_LIMIT=20
MAIL_GLOBAL_DAILY_LIMIT=2000

# Optional: comma-separated company ids that get Pro for free (or use: start.sh grant-pro <id>).
PRO_TENANT_IDS=
