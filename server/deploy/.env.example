# Copy to .env (never commit .env) and fill in.

# Application (client) ID of the Azure app registration (same as in msal_config.json).
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Public URL the phones use, without a trailing slash.
PUBLIC_BASE_URL=https://apps.example.com/supportvisit

# Random secret for temporary file links, at least 32 characters:  openssl rand -base64 48
LINK_SECRET=

# Optional: comma-separated Microsoft tenant IDs allowed to use this server. Empty = any company.
ALLOWED_TENANT_IDS=
