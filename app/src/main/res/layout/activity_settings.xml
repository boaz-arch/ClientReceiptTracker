<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="64dp"
        android:paddingBottom="40dp">

        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/mode_settings" />

        <!-- Segmented selector: the active theme is shown as selected. -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/themeToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/btnLightMode"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/light_mode" />

            <Button
                android:id="@+id/btnDarkMode"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dark_mode" />

            <Button
                android:id="@+id/btnSystemMode"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/system_mode" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/report_settings" />

        <Button
            android:id="@+id/btnBillingSettings"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/billing_settings" />

        <Button
            android:id="@+id/btnCustomizeReport"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/customize_report" />

        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/export_data" />

        <Button
            android:id="@+id/btnExportCsv"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/export_csv" />

        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/login_settings" />

        <Button
            android:id="@+id/btnConnectMicrosoft"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/connect_microsoft_account" />

        <Button
            android:id="@+id/btnDisconnectMicrosoft"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/disconnect_microsoft_account" />

        <Button
            android:id="@+id/btnDeleteAccount"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/delete_account"
            android:textColor="?attr/colorError"
            app:strokeColor="?attr/colorError" />



        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/company_footer"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:paddingBottom="40dp"/>


    </LinearLayout>

</ScrollView>