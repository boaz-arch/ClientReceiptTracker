<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="40dp">

        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/mode_settings" />

        <!-- Segmented selector: the active theme is shown as selected. -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/themeToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/btnLightMode"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/light_mode" />

            <Button
                android:id="@+id/btnDarkMode"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dark_mode" />

            <Button
                android:id="@+id/btnSystemMode"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/system_mode" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/language_settings" />

        <!-- Language: each name is written in its own language, so it can always be found. -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/languageToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/btnLanguageSystem"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/system_mode" />

            <Button
                android:id="@+id/btnLanguageEnglish"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/language_english" />

            <Button
                android:id="@+id/btnLanguageHebrew"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/language_hebrew" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Company: admins only (or a phone working on its own). -->
        <LinearLayout
            android:id="@+id/sectionCompany"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/SettingsSectionHeader"
                android:text="@string/company_settings" />

            <Button
                android:id="@+id/btnCompanyProfile"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/company_profile" />

            <Button
                android:id="@+id/btnTeamMembers"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/team_members" />

        </LinearLayout>

        <TextView
            android:id="@+id/headerReportSettings"
            style="@style/SettingsSectionHeader"
            android:text="@string/report_settings" />

        <Button
            android:id="@+id/btnBillingSettings"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/billing_settings" />

        <Button
            android:id="@+id/btnCustomizeReport"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/customize_report" />

        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/security_settings" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAppLock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/app_lock" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_lock_summary"
            android:textAlignment="viewStart"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/export_data" />

        <Button
            android:id="@+id/btnExportCsv"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/export_csv" />

        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/privacy_settings" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchTelemetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/telemetry_switch" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/telemetry_summary"
            android:textAlignment="viewStart"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPrivacyPolicy"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/privacy_policy" />

            <Button
                android:id="@+id/btnTerms"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/terms_of_use" />

        </LinearLayout>

        <Button
            android:id="@+id/btnClearLocalData"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/clear_local_data" />

        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/login_settings" />

        <Button
            android:id="@+id/btnConnectMicrosoft"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sign_in_title" />

        <Button
            android:id="@+id/btnDisconnectMicrosoft"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sign_out" />

        <Button
            android:id="@+id/btnDeleteAccount"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/delete_account"
            android:textColor="?attr/colorError"
            app:strokeColor="?attr/colorError" />



        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:paddingBottom="40dp"/>


    </LinearLayout>

</ScrollView>