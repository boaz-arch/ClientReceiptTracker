<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="104dp"
    android:layout_height="104dp"
    android:layout_marginEnd="8dp">

    <ImageView
        android:id="@+id/ivPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/signature_bg"
        android:contentDescription="@string/photo_thumbnail"
        android:scaleType="centerCrop" />

    <ImageButton
        android:id="@+id/btnRemovePhoto"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:background="@drawable/bg_remove_button"
        android:contentDescription="@string/remove_photo"
        android:src="@android:drawable/ic_menu_close_clear_cancel" />

</FrameLayout>
