<?xml version="1.0" encoding="utf-8"?>
<!-- Home = dashboard. New Visit stays the most prominent action. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_title"
            android:textAlignment="viewStart"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/loading_user"
            android:textAlignment="viewStart"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/btnNewVisit"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:text="@string/add_new_visit_report"
            android:textSize="18sp"
            app:icon="@android:drawable/ic_input_add"
            app:iconGravity="textStart" />

        <!-- Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPastVisits"
                style="@style/DashboardNavButton"
                android:layout_marginEnd="4dp"
                android:text="@string/view_my_past_visits" />

            <Button
                android:id="@+id/btnClients"
                style="@style/DashboardNavButton"
                android:layout_marginStart="4dp"
                android:text="@string/clients_title" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMonthlyReports"
                style="@style/DashboardNavButton"
                android:layout_marginEnd="4dp"
                android:text="@string/monthly_report_title" />

            <Button
                android:id="@+id/btnSettings"
                style="@style/DashboardNavButton"
                android:layout_marginStart="4dp"
                android:text="@string/settings" />

        </LinearLayout>

        <!-- Filters -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedChip="@id/chipThisMonth"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipThisMonth"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/range_this_month" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLastMonth"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/range_last_month" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipQuarter"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/range_quarter" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCustom"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/range_custom" />

            </com.google.android.material.chip.ChipGroup>

        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:hint="@string/label_client">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actFilterClient"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFilterTechnician"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:hint="@string/label_technician">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actFilterTechnician"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- KPI cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout style="@style/KpiCard" android:layout_marginEnd="4dp">
                <TextView android:id="@+id/tvKpiVisits" style="@style/KpiValue" />
                <TextView style="@style/KpiLabel" android:text="@string/kpi_visits" />
            </LinearLayout>

            <LinearLayout style="@style/KpiCard" android:layout_marginStart="4dp">
                <TextView android:id="@+id/tvKpiHours" style="@style/KpiValue" />
                <TextView style="@style/KpiLabel" android:text="@string/kpi_hours" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout android:id="@+id/cardKpiAmount" style="@style/KpiCard" android:layout_marginEnd="4dp">
                <TextView android:id="@+id/tvKpiAmount" style="@style/KpiValue" />
                <TextView style="@style/KpiLabel" android:text="@string/kpi_amount" />
            </LinearLayout>

            <LinearLayout android:id="@+id/cardKpiUnsent" style="@style/KpiCard" android:layout_marginStart="4dp">
                <TextView android:id="@+id/tvKpiUnsent" style="@style/KpiValue" />
                <TextView style="@style/KpiLabel" android:text="@string/kpi_unsent" />
            </LinearLayout>

        </LinearLayout>

        <!-- Hours per client -->
        <LinearLayout style="@style/ChartCard">
            <TextView style="@style/ChartTitle" android:text="@string/chart_hours_per_client" />
            <com.patrykandpatrick.vico.views.cartesian.CartesianChartView
                android:id="@+id/chartClients"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                app:chartStyle="@style/ChartColumns"
                app:scrollEnabled="false"
                app:zoomEnabled="false" />
            <TextView android:id="@+id/tvClientsEmpty" style="@style/ChartEmpty" />
        </LinearLayout>

        <!-- Visits and hours per week -->
        <LinearLayout style="@style/ChartCard">
            <TextView style="@style/ChartTitle" android:text="@string/chart_weekly" />
            <com.patrykandpatrick.vico.views.cartesian.CartesianChartView
                android:id="@+id/chartWeeks"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                app:chartStyle="@style/ChartLines"
                app:scrollEnabled="false"
                app:zoomEnabled="false" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/chart_weekly_legend"
                android:textAlignment="viewStart"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Hours per technician (Phase 5: managers only) -->
        <LinearLayout android:id="@+id/cardTechnicians" style="@style/ChartCard">
            <TextView style="@style/ChartTitle" android:text="@string/chart_hours_per_technician" />
            <com.patrykandpatrick.vico.views.cartesian.CartesianChartView
                android:id="@+id/chartTechnicians"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                app:chartStyle="@style/ChartColumns"
                app:scrollEnabled="false"
                app:zoomEnabled="false" />
        </LinearLayout>

        <!-- Support package usage -->
        <LinearLayout android:id="@+id/cardRetainers" style="@style/ChartCard">
            <TextView style="@style/ChartTitle" android:text="@string/chart_retainers" />
            <LinearLayout
                android:id="@+id/retainerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Visits by type -->
        <LinearLayout style="@style/ChartCard">
            <TextView style="@style/ChartTitle" android:text="@string/chart_visit_types" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <com.company.supportvisit.ui.DonutChartView
                    android:id="@+id/donutTypes"
                    android:layout_width="140dp"
                    android:layout_height="140dp" />
                <LinearLayout
                    android:id="@+id/typeLegend"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical" />
            </LinearLayout>
            <TextView android:id="@+id/tvTypesEmpty" style="@style/ChartEmpty" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/company_footer"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
