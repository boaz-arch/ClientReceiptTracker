<?xml version="1.0" encoding="utf-8"?>
<!-- Home: greeting, the main actions (new visit, visit reports, clients), this month at a glance. Charts live in Insights. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp"
        android:focusableInTouchMode="true"
        android:descendantFocusability="beforeDescendants">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/loading_user"
                    android:textAlignment="viewStart"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvToday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings"
                android:src="@drawable/ic_settings" />

        </LinearLayout>

        <!-- The main action -->
        <Button
            android:id="@+id/btnNewVisit"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="20dp"
            android:text="@string/add_new_visit_report"
            android:textSize="18sp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart" />

        <Button
            android:id="@+id/btnPastVisits"
            style="@style/HomeMainButton"
            android:layout_marginTop="10dp"
            android:text="@string/view_my_past_visits" />

        <Button
            android:id="@+id/btnClients"
            style="@style/HomeMainButton"
            android:layout_marginTop="10dp"
            android:text="@string/clients_title" />

        <!-- Shown only when a New Visit form was left unfinished -->
        <TextView
            android:id="@+id/tvDraft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_search_field"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:textAlignment="viewStart"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone" />

        <!-- Shown only when something is waiting to be sent -->
        <TextView
            android:id="@+id/tvUnsent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_search_field"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:textAlignment="viewStart"
            android:textColor="@color/status_pending"
            android:visibility="gone" />

        <!-- This month at a glance (tap for Insights) -->
        <LinearLayout
            android:id="@+id/cardMonth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/this_month"
                android:textAlignment="viewStart"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout style="@style/StatColumn">
                    <TextView android:id="@+id/tvKpiVisits" style="@style/KpiValue" />
                    <TextView style="@style/KpiLabel" android:text="@string/kpi_visits" />
                </LinearLayout>

                <LinearLayout style="@style/StatColumn">
                    <TextView android:id="@+id/tvKpiHours" style="@style/KpiValue" />
                    <TextView style="@style/KpiLabel" android:text="@string/kpi_hours" />
                </LinearLayout>

                <LinearLayout android:id="@+id/colKpiAmount" style="@style/StatColumn">
                    <TextView android:id="@+id/tvKpiAmount" style="@style/KpiValue" />
                    <TextView style="@style/KpiLabel" android:text="@string/kpi_amount_short" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Secondary: monthly reports and charts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMonthlyReports"
                style="@style/HomeLink"
                android:layout_marginEnd="4dp"
                android:text="@string/monthly_report_title" />

            <Button
                android:id="@+id/btnInsights"
                style="@style/HomeLink"
                android:layout_marginStart="4dp"
                android:text="@string/insights_title" />

        </LinearLayout>

        <Button
            android:id="@+id/btnTasks"
            style="@style/HomeLink"
            android:layout_width="match_parent"
            android:layout_weight="0"
            android:layout_marginTop="4dp"
            android:text="@string/home_tasks" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
