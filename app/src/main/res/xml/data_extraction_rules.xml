<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: nothing is copied to Google backups or to a new phone. The data holds client
    details and signatures, and the session token is tied to this device; after a phone change
    the person signs in again and the team's data comes back from the server.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
