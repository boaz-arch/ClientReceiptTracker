<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. The server address is built into the app and must be https://. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
