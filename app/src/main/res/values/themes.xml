<resources xmlns:tools="http://schemas.android.com/tools">

    <style
        name="Theme.SupportVisit"
        parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:statusBarColor">@color/primary_dark</item>

    </style>

    <style name="SettingsSectionHeader">

        <item name="android:layout_width">
            wrap_content
        </item>

        <item name="android:layout_height">
            wrap_content
        </item>

        <item name="android:textSize">
            13sp
        </item>

        <item name="android:textStyle">
            bold
        </item>

        <item name="android:textAllCaps">
            true
        </item>

        <item name="android:letterSpacing">
            0.05
        </item>

        <item name="android:textColor">
            @color/primary
        </item>

        <item name="android:layout_marginTop">
            18dp
        </item>

    </style>

    <style name="SettingsDivider">

        <item name="android:layout_width">
            match_parent
        </item>

        <item name="android:layout_height">
            1dp
        </item>

        <item name="android:layout_marginTop">
            18dp
        </item>

    </style>

</resources>